// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanId {
  starter
  professional
  enterprise
}

enum TenantStatus {
  active
  trial
  suspended
  churned
}

enum UserRole {
  Owner
  Admin
  Manager
  Cashier
  Driver
}

enum UserStatus {
  active
  invited
  disabled
}

model Tenant {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  contactName       String
  email             String
  phone             String
  country           String
  currency          String
  locale            String       @default("en")
  plan              PlanId
  status            TenantStatus
  createdAt         DateTime     @default(now())
  trialEndsAt       DateTime?
  branches          Int          @default(1)
  seatsUsed         Int          @default(0)
  storageUsedMB     Int          @default(0)
  monthlyOrders     Int          @default(0)
  mrr               Float        @default(0)
  featureOverrides  Json         @default("{}")
  taxEnabled        Boolean      @default(false)
  taxRate           Float        @default(0)
  logoUrl           String?
  trn               String?
  address           String?
  receiptNote       String?
  paymentMethods    String[]     @default([])
  deliveryTypes     String[]     @default([])
  hangFoldOptions   String[]     @default([])
  serviceCategories String[]     @default([])
  placements        String[]     @default([])

  users TenantUser[]
}

model TenantUser {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  name            String
  email           String
  role            UserRole
  department      String
  status          UserStatus
  lastActive      DateTime   @default(now())
  passwordHash    String
  username        String
  moduleOverrides Json       @default("{}")

  @@unique([tenantId, username])
}

enum OrderStatus {
  Draft
  JobOrder  @map("Job Order")
  Ready
  Delivered
  Cancelled
}

enum CreditAddMethod {
  Cash
  Card
  EFT
}

enum MessageStatus {
  sent
  failed
}

model Plan {
  id             PlanId   @id
  name           String
  priceMonthly   Float
  blurb          String
  seatLimit      Int?
  branchLimit    Int?
  storageLimitMB Int
  features       String[] @default([])
}

model POSCustomer {
  id            String   @id @default(cuid())
  tenantId      String
  fullName      String
  phone         String
  address       String
  balance       Float    @default(0)
  isBlacklist   Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())
  creditBalance Float    @default(0)

  creditLogs CreditLog[]
  orders     POSOrder[]
  messages   WhatsAppMessage[]
}

model CreditLog {
  id         String          @id @default(cuid())
  customerId String
  customer   POSCustomer     @relation(fields: [customerId], references: [id])
  date       DateTime        @default(now())
  type       CreditAddMethod
  amount     Float
}

model POSService {
  id         String  @id @default(cuid())
  tenantId   String
  name       String
  nameArabic String?
  category   String
  prices     Json    @default("{}")
  active     Boolean @default(true)
}

model POSOrder {
  id            String      @id @default(cuid())
  tenantId      String
  reference     String
  customerId    String
  customer      POSCustomer @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  date          DateTime
  orderTime     String?
  deliveryType  String
  deliveryDate  DateTime
  pickupTime    String?
  placement     String?
  status        OrderStatus
  sub           Float
  discount      Float       @default(0)
  taxRate       Float?
  tax           Float?
  total         Float
  paid          Float       @default(0)
  balance       Float       @default(0)
  salesman      String
  driver        String?
  notes         String?
  createdAt     DateTime    @default(now())

  items    POSOrderItem[]
  payments POSPayment[]
  messages WhatsAppMessage[]
}

model POSOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       POSOrder @relation(fields: [orderId], references: [id])
  serviceId   String
  serviceName String
  serviceType String
  qty         Int
  unitPrice   Float
  hangFold    String
  urgent      Boolean  @default(false)
  nasha       String   @default("None")
  placement   String?
  lineTotal   Float
}

model POSPayment {
  id      String   @id @default(cuid())
  orderId String
  order   POSOrder @relation(fields: [orderId], references: [id])
  date    DateTime
  type    String
  amount  Float
  ref     String?
}

model WhatsAppMessage {
  id         String        @id @default(cuid())
  tenantId   String
  customerId String
  customer   POSCustomer   @relation(fields: [customerId], references: [id])
  orderId    String?
  order      POSOrder?     @relation(fields: [orderId], references: [id])
  text       String
  to         String
  sentAt     DateTime      @default(now())
  status     MessageStatus
}

enum ActivityKind {
  signup
  upgrade
  downgrade
  suspend
  reactivate
  invite
  payment
  login
}

model ActivityEvent {
  id         String       @id @default(cuid())
  tenantId   String
  tenantName String
  kind       ActivityKind
  message    String
  at         DateTime     @default(now())
}

model AdminAccount {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  mustReset    Boolean @default(false)
}
